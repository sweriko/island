      SizeX=720
      SizeY=224
      Text="This MF separates the curved from the flat surfaces.\r\nIt checks using DDX and DDY nodes whether the normal vector changes from one pixel to the next.\r\nCurved Surface = 1 (White)\r\nFlat Surface = 0 (Black)\r\nIf you want to know more about DDX / DDY:\r\nhttps://youtu.be/-ynkbsCT2Ic?si=YgmwsEiStZ0klbnl"
      CommentColor=(R=0.417885,G=0.686686,B=0.791298,A=1.000000)
      MaterialExpressionEditorX=-5776
      MaterialExpressionEditorY=-912
      MaterialExpressionGuid=1C43D1584A89B348081223B638EF69FA
      Material="/Script/Engine.Material'M_PainterlyShader'"
   End Object
