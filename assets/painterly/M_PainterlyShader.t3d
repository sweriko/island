   Begin Object Name="MaterialExpressionComment_34" ExportPath="/Script/Engine.MaterialExpressionComment'/Game/Painterly/Materials/M_PainterlyShader.M_PainterlyShader:MaterialExpressionComment_34'"
      SizeX=416
      SizeY=128
      Text="We are calculating the angle of reflection between the sun and the camera to create specular highlights.\r\nQ: How much does my surface normal align with the angle of perfect reflection? \r\nThe more they align, the brighter the specular highlight should be."
      CommentColor=(R=1.000000,G=0.679543,B=0.000000,A=1.000000)
      FontSize=12
      MaterialExpressionEditorX=-1840
      MaterialExpressionEditorY=-448
      MaterialExpressionGuid=C68F7AAF4DFCEC7485BCA4AF7DB4650C
      Material="/Script/Engine.Material'M_PainterlyShader'"
   End Object
